# ===========================================
# CONFIGURACIÓN - TEMPLATE
# Copiar a .env y completar valores
# ===========================================

# API DataBursatil
DATABURSATIL_API_TOKEN=tu_token_de_30_caracteres_aqui
DATABURSATIL_BASE_URL=https://api.databursatil.com/v2

# SQL Server (Local via SSH Tunnel)
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=MercadoBursatil
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=tu_password_sqlserver
SQL_SERVER_DRIVER=ODBC Driver 17 for SQL Server
# Alternative driver: SQL Server Native Client 11.0

# SSH Tunnel (Cloudflare)
SSH_ENABLED=true
SSH_HOSTNAME=ssh.rod-b-op.com
SSH_USER=rodri
SSH_LOCAL_PORT=1433
SSH_REMOTE_PORT=1433
CLOUDFLARE_TUNNEL_ID=5a5dd112-9705-4f62-b97f-c7723daf5afc

# Configuración ETL
ETL_BATCH_SIZE=50
ETL_MAX_RETRIES=3
ETL_RETRY_DELAY=5
ETL_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/etl.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# Data Storage
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_BACKUP_DIR=data/backups

# Development
DEBUG=false
ENVIRONMENT=production
